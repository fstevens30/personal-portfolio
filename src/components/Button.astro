---
import {
  CircleAlert,
  CircleCheck,
  LoaderCircle,
  SquareArrowOutUpRight,
} from "@lucide/astro";

interface ButtonProps {
  href?: string;
  text: string;
  primary?: boolean;
  isExternal?: boolean;
  disabled?: boolean;
  state?: "default" | "loading" | "error" | "success";
}

const {
  href = "",
  text,
  primary = false,
  isExternal = false,
  disabled = false,
  state = "default",
} = Astro.props as ButtonProps;

const isUnavailable = disabled || state === "loading";
const stateLabel = state === "default" ? text : `${text} — ${state}`;
---

{
  isUnavailable ? (
    <span
      class={`button ${primary ? "button--primary" : "button--secondary"}`}
      aria-disabled="true"
      aria-busy={state === "loading" ? "true" : undefined}
      aria-label={stateLabel}
      data-state={state}
    >
      {state === "loading" && <LoaderCircle size={14} aria-hidden="true" />}
      <span>{text}</span>
      {isExternal && <SquareArrowOutUpRight size={12} />}
    </span>
  ) : (
    <a
      href={href}
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
      class={`button ${primary ? "button--primary" : "button--secondary"}`}
      aria-label={stateLabel}
      data-state={state}
    >
      {state === "error" && <CircleAlert size={14} aria-hidden="true" />}
      {state === "success" && <CircleCheck size={14} aria-hidden="true" />}
      <span>{text}</span>
      {isExternal && <SquareArrowOutUpRight size={12} />}
    </a>
  )
}
