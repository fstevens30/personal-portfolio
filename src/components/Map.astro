---
interface Props {
  latitude?: number;
  longitude?: number;
  zoom?: number;
}
const { latitude = 0, longitude = 0, zoom = 10 } = Astro.props;
---

<figure
  class="map-figure"
  aria-label="Flynn’s journey through Invercargill, Nelson, and Christchurch"
>
  <div
    id="map"
    class="map-canvas"
    role="region"
    aria-label="Interactive map showing the route from Invercargill to Nelson and Christchurch"
  >
  </div>
  <figcaption class="map-caption">
    Invercargill → Nelson → Christchurch
  </figcaption>
</figure>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl/dist/maplibre-gl.css" />

<script define:vars={{ latitude, longitude, zoom }}>
  window.__mapConfig = { latitude, longitude, zoom };
</script>

<script>
  import maplibregl from "maplibre-gl";
  import {
    createJourneyArcs,
    toLegacyRgb,
    type Position,
  } from "../lib/journey-map";

  const { latitude, longitude, zoom } = (window as any).__mapConfig;
  const points: Position[] = [
    [168.347, -46.4118],
    [173.2838, -41.2743],
    [172.6366, -43.5309],
  ];

  function getMapStyle() {
    return document.documentElement.classList.contains("dark")
      ? "https://tiles.openfreemap.org/styles/dark"
      : "https://tiles.openfreemap.org/styles/bright";
  }

  function resolveColor(token: string) {
    const probe = document.createElement("span");
    probe.style.color = `var(${token})`;
    probe.hidden = true;
    document.body.append(probe);
    const color = getComputedStyle(probe).color;
    probe.remove();

    const canvas = document.createElement("canvas");
    canvas.width = 1;
    canvas.height = 1;
    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) return toLegacyRgb(color);

    context.fillStyle = color;
    context.fillRect(0, 0, 1, 1);
    return toLegacyRgb(context.getImageData(0, 0, 1, 1).data);
  }

  const map = new maplibregl.Map({
    container: "map",
    style: getMapStyle(),
    center: [longitude, latitude],
    zoom,
  });

  function addMarkers() {
    if (document.querySelector(".maplibregl-marker")) return;
    const muted = resolveColor("--color-map-muted");
    const accent = resolveColor("--color-accent-strong");
    new maplibregl.Marker({ color: muted }).setLngLat(points[0]).addTo(map);
    new maplibregl.Marker({ color: muted }).setLngLat(points[1]).addTo(map);
    new maplibregl.Marker({ color: accent }).setLngLat(points[2]).addTo(map);
  }

  function addLayers() {
    addMarkers();
    if (!map.getSource("route")) {
      map.addSource("route", {
        type: "geojson",
        data: createJourneyArcs(points),
      });
    }

    if (!map.getLayer("route-line")) {
      map.addLayer({
        id: "route-line",
        type: "line",
        source: "route",
        layout: { "line-join": "round", "line-cap": "round" },
        paint: {
          "line-color": resolveColor("--color-accent-strong"),
          "line-width": 3,
          "line-opacity": 0.82,
          "line-dasharray": [0.1, 2.1],
        },
      });
    }
  }

  map.on("load", addLayers);
  map.on("style.load", addLayers);

  const observer = new MutationObserver(() => map.setStyle(getMapStyle()));
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>
