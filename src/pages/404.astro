---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Page not found — Flynn Stevens"
  description="The page you are looking for does not exist."
>
  <main class="page-frame error-page">
    <p class="error-page__code">Error 404</p>
    <h1 class="error-page__title">This path ends here.</h1>
    <p class="error-page__copy">
      The page may have moved, or the address may be incomplete. The home page
      is a good place to pick up the trail.
    </p>
    <Button href="/" text="Return home" primary />
  </main>
</Layout>
