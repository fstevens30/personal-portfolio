---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Rss } from "lucide-astro";

const POSTS_PER_PAGE = 10;
const page = Number(Astro.url.searchParams.get("page")) || 1;
const allPosts = await getCollection(
  "blog",
  ({ data }: { data: CollectionEntry<"blog">["data"] }) => data.published,
);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);
const displayPosts = sortedPosts.slice(
  (page - 1) * POSTS_PER_PAGE,
  page * POSTS_PER_PAGE,
);
---

<Layout
  title="Writing — Flynn Stevens"
  description="Notes on software, mapping, mobile development, and personal projects."
>
  <main class="page-frame blog-archive">
    <header class="page-intro">
      <h1 class="page-title">Field notes</h1>
      <div>
        <p class="page-lede">
          Notes on software, mapping, mobile development, and the things I learn
          while building.
        </p>
        <a class="text-link" href="/rss.xml">
          <Rss size={15} aria-hidden="true" /> Subscribe via RSS
        </a>
      </div>
    </header>

    {
      displayPosts.length > 0 ? (
        <ol class="archive-list">
          {displayPosts.map((post) => (
            <li class="archive-entry">
              <time class="metadata" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-NZ", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <a href={`/blog/${post.id}`} class="archive-entry__link">
                <h2 class="archive-entry__title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="archive-entry__description">
                    {post.data.description}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="page-lede">No posts yet. Check back later.</p>
      )
    }

    {
      totalPages > 1 && (
        <nav class="pagination" aria-label="Blog pages">
          {page > 1 && (
            <a class="button button--secondary" href={`/blog?page=${page - 1}`}>
              Previous
            </a>
          )}
          <span class="metadata">
            {page} / {totalPages}
          </span>
          {page < totalPages && (
            <a class="button button--secondary" href={`/blog?page=${page + 1}`}>
              Next
            </a>
          )}
        </nav>
      )
    }
  </main>
</Layout>
