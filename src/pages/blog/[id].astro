---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { id: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post }: { post: CollectionEntry<"blog"> } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Flynn Stevens`}
  description={post.data.description}
>
  <main class="article-frame">
    <header class="article-header">
      <time class="metadata" datetime={post.data.date.toISOString()}>
        {
          post.data.date.toLocaleDateString("en-NZ", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      <h1 class="article-title">{post.data.title}</h1>
      {
        post.data.description && (
          <p class="article-description">
            {post.data.description}
          </p>
        )
      }
    </header>
    <article class="prose article-prose">
      <Content />
    </article>
  </main>
</Layout>

<script>
  document.querySelectorAll("article a[href^='http']").forEach((link) => {
    link.setAttribute("target", "_blank");
    link.setAttribute("rel", "noopener noreferrer");
  });
</script>
