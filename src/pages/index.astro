---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

const socialLinks = [
  { href: "https://github.com/fstevens30", label: "GitHub" },
  { href: "https://bsky.app/profile/flynnstevens.dev", label: "Bluesky" },
  { href: "https://www.linkedin.com/in/fstevens30/", label: "LinkedIn" },
  { href: "https://twitter.com/flynnstevens30", label: "Twitter" },
];

const tech = [
  { name: "Swift", icon: "/icons/swift.svg" },
  { name: "TypeScript", icon: "/icons/typescript.svg" },
  { name: "Bun", icon: "/icons/bun.svg" },
  { name: "Next.js", icon: "/icons/nextjs.svg" },
  { name: "PostgreSQL", icon: "/icons/postgresql.svg" },
  { name: "Tailwind CSS", icon: "/icons/tailwind.svg" },
  { name: "Supabase", icon: "/icons/supabase.svg" },
  { name: "Git", icon: "/icons/git.svg" },
  { name: "C#", icon: "/icons/csharp.svg" },
  { name: "OpenStreetMap", icon: "/icons/openstreetmap.svg" },
  { name: "MapLibre", icon: "/icons/maplibre.svg" },
  { name: "Docker", icon: "/icons/docker.svg" },
  { name: "tRPC", icon: "/icons/trpc.svg" },
  { name: "Astro", icon: "/icons/astro.svg" },
  { name: "Drizzle", icon: "/icons/drizzle.svg" },
  { name: "Zod", icon: "/icons/zod.svg" },
];
---

<Layout
  title="Flynn Stevens"
  description="Junior Software Developer based in Ōtautahi, Aotearoa"
>
  <main class="page-frame home-workbench">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="metadata">Ōtautahi · Aotearoa</p>
        <h1 id="home-title" class="home-hero__title">Kia ora, I’m Flynn.</h1>
        <p class="home-hero__lede">
          A junior software developer working on web-based mapping applications
          and cross-platform mobile apps.
        </p>
        <div class="button-row">
          <Button href="/projects" text="Explore projects" primary />
          <Button href="/blog" text="Read the journal" />
        </div>
      </div>

      <aside class="profile-panel" aria-label="Current role and social links">
        <img
          src="/images/profile.webp"
          alt="Flynn Stevens"
          width="640"
          height="800"
          class="profile-panel__image"
          fetchpriority="high"
        />
        <div class="profile-panel__body">
          <p class="profile-panel__role">
            Junior Software Developer at Contec Group International.
          </p>
          <div class="social-list" aria-label="Connect with Flynn">
            {
              socialLinks.map((link) => (
                <a
                  class="text-link"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </section>

    <section class="home-note" aria-labelledby="practice-title">
      <h2 id="practice-title" class="home-note__title">What I work on</h2>
      <div class="home-note__copy">
        <p>
          I enjoy working with web and mobile technologies, particularly mapping
          and geospatial tools. Learning how systems work beneath the surface is
          one of my favourite parts of software development.
        </p>
        <p>
          At Contec Group International, I work on mapping applications for the
          dairy industry. Outside work, I build personal projects and maintain a
          homelab.
        </p>
      </div>
    </section>

    <section class="tech-index" aria-labelledby="tech-title">
      <header class="tech-index__head">
        <h2 id="tech-title" class="tech-index__title">Tools on the bench</h2>
        <a
          class="text-link"
          href="https://wakatime.com/@fstevens30"
          target="_blank"
          rel="noopener noreferrer">Day-to-day activity on WakaTime</a
        >
      </header>
      <div class="tech-index__list">
        {
          tech.map((item) => (
            <div class="tech-item">
              <img src={item.icon} alt="" width="32" height="32" loading="lazy" />
              <span>{item.name}</span>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
