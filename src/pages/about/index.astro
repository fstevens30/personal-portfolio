---
import Layout from "../../layouts/Layout.astro";
import Map from "../../components/Map.astro";
---

<Layout
  title="About — Flynn Stevens"
  description="Flynn Stevens’ journey from Invercargill to Christchurch and into software development."
>
  <main class="page-frame about-journey">
    <section class="about-opening" aria-labelledby="about-title">
      <img
        src="/images/profile.webp"
        alt="Flynn Stevens"
        class="about-opening__image"
        width="640"
        height="800"
        fetchpriority="high"
      />
      <div class="about-opening__copy">
        <p class="metadata">Developer · Map enthusiast · Homelab tinkerer</p>
        <h1 id="about-title" class="about-opening__title">A little more personal.</h1>
        <p class="about-opening__lede">
          I’m a software developer based in Christchurch, New Zealand. I enjoy
          solving practical problems and understanding how systems work beneath
          the surface.
        </p>
        <p class="page-lede">
          Away from work, I spend time hiking, gaming, building personal
          projects, and maintaining my homelab.
        </p>
      </div>
    </section>

    <section class="journey" aria-labelledby="journey-title">
      <h2 id="journey-title" class="journey-title">How I got here.</h2>

      <article class="journey-stop">
        <img
          src="/images/invers.jpg"
          alt="Invercargill, New Zealand"
          class="journey-stop__image"
          width="1200"
          height="800"
          loading="lazy"
        />
        <div class="journey-stop__copy">
          <p class="metadata">Invercargill</p>
          <h3 class="journey-stop__title">Where I grew up</h3>
          <p>
            I grew up in Invercargill before moving north at nineteen for a
            change of scenery and a fresh start.
          </p>
        </div>
      </article>

      <article class="journey-stop">
        <img
          src="/images/nelson.jpg"
          alt="Nelson, New Zealand"
          class="journey-stop__image"
          width="1200"
          height="800"
          loading="lazy"
        />
        <div class="journey-stop__copy">
          <p class="metadata">Nelson</p>
          <h3 class="journey-stop__title">Finding software</h3>
          <p>
            In Nelson, I enrolled in the Diploma in Web Design and Development
            at NMIT. That was where I discovered my passion for software
            development.
          </p>
        </div>
      </article>

      <article class="journey-stop">
        <img
          src="/images/chch.jpg"
          alt="Christchurch, New Zealand"
          class="journey-stop__image"
          width="1200"
          height="800"
          loading="lazy"
        />
        <div class="journey-stop__copy">
          <p class="metadata">Christchurch</p>
          <h3 class="journey-stop__title">Building a career</h3>
          <p>
            After moving to Christchurch, I completed my Bachelor of Information
            Technology at Ara Institute of Canterbury. I now work at
            <a
              class="text-link"
              href="https://madcapdairysoftware.com/"
              target="_blank"
              rel="noopener noreferrer">Contec Group International</a
            >, building mapping applications for the dairy industry.
          </p>
        </div>
      </article>

      <Map latitude={-43} longitude={170} zoom={4} />
    </section>
  </main>
</Layout>
