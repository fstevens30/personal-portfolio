---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";

type Project = {
  title: string;
  date: Date;
  description: string;
  image: string;
  tags: string[];
  viewLink?: string;
  sourceLink?: string;
};

const projects: Project[] = [
  {
    title: "NZ Healthcare",
    date: new Date("2023-11-01"),
    description: "Fictional healthcare provider portal, made with Django.",
    image: "/images/nz-healthcare.png",
    tags: ["Django", "Python", "HTML", "CSS", "MySQL"],
    sourceLink: "https://github.com/fstevens30/NZhealthcare",
  },
  {
    title: "Kiwi Huts iOS",
    date: new Date("2024-06-01"),
    description:
      "Built with SwiftUI, explore DOC huts in New Zealand. Currently unavailable.",
    image: "/images/kiwi-huts.png",
    tags: ["Swift", "SwiftUI", "MapKit", "Firebase", "Python"],
    sourceLink: "https://github.com/fstevens30/Kiwi-Huts-iOS",
  },
  {
    title: "Ferrostar .NET MAUI",
    date: new Date("2025-11-01"),
    description:
      "Cross-platform mobile navigation library, porting Ferrostar to work with .NET MAUI.",
    image: "/images/ferrostar-maui.png",
    tags: ["C#", ".NET MAUI", "Ferrostar", "Android", "MapLibre"],
    viewLink: "/blog/ferrostar-maui",
  },
  {
    title: "Virtual Emerge",
    date: new Date("2024-11-01"),
    description:
      "Explore Ara BICT student final-year projects in the Virtual Emerge showcase.",
    image: "/images/virtual-emerge.png",
    tags: ["Next.js", "TypeScript", "shadcn/ui", "Tailwind CSS", "Supabase"],
    viewLink: "https://virtual-emerge.vercel.app/",
    sourceLink: "https://github.com/fstevens30/virtual-emerge",
  },
  {
    title: "Personal Portfolio",
    date: new Date("2026-06-01"),
    description: "This website: a showcase of my work and a technical journal.",
    image: "/images/placeholder.webp",
    tags: ["Astro", "Tailwind CSS", "TypeScript", "MapLibre"],
    viewLink: "https://flynnstevens.dev",
    sourceLink: "https://github.com/fstevens30/personal-portfolio",
  },
  {
    title: "Glance Dashboard",
    date: new Date("2026-05-01"),
    description:
      "A dashboard for my homelab, built with the Glances API and Glance dashboard project.",
    image: "/images/glance.png",
    tags: ["YAML", "Docker", "Homelab"],
    sourceLink: "https://github.com/fstevens30/glance-dashboard-config",
  },
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout
  title="Projects — Flynn Stevens"
  description="Selected software projects by Flynn Stevens."
>
  <main class="page-frame project-catalogue">
    <header class="page-intro">
      <h1 class="page-title">Selected projects</h1>
      <p class="page-lede">
        Mapping tools, mobile applications, student showcases, and small systems
        built to solve practical problems.
      </p>
    </header>

    <ol class="project-list">
      {
        projects.map((project) => (
          <li class="project-entry">
            <figure class="project-entry__media">
              <img
                src={project.image}
                alt={`${project.title} interface`}
                class="project-entry__image"
                loading="lazy"
                width="1200"
                height="750"
              />
            </figure>
            <div class="project-entry__content">
              <time class="metadata" datetime={project.date.toISOString()}>
                {project.date.toLocaleDateString("en-NZ", {
                  year: "numeric",
                  month: "long",
                })}
              </time>
              <h2 class="project-entry__title">{project.title}</h2>
              <p class="project-entry__description">{project.description}</p>
              <div class="tag-list" aria-label="Technologies">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <div class="project-actions">
                {project.viewLink ? (
                  <Button
                    href={project.viewLink}
                    text="View project"
                    primary
                    isExternal={project.viewLink.startsWith("http")}
                  />
                ) : (
                  <Button text="View unavailable" primary disabled />
                )}
                {project.sourceLink ? (
                  <Button
                    href={project.sourceLink}
                    text="View source"
                    isExternal
                  />
                ) : (
                  <Button text="Source unavailable" disabled />
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </main>
</Layout>
